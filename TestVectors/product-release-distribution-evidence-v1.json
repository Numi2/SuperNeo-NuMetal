  "requiredVerificationSteps": [
    "verify release evidence schema and digest before trusting release notes",
    "verify every artifact digest is listed in the signed provenance packet",
    "verify every artifact signature digest validates under the pinned release signing key",
    "verify the signing key digest is pinned in the release evidence",
    "verify production gate result equals passed for release candidates that claim the full local gate",
    "verify notarization ticket or platform publication proof before production-security distribution",
    "verify hosted branch-protection evidence before production-security distribution",
    "reject production-security language while any release-distribution promotion flag remains false"
