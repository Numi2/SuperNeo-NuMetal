}

public enum SuperNeoError : Error, Equatable {
  case divisionByZero
  case invalidEncoding(String)
  case invalidParameter(String)
  case randomnessUnavailable(String)
  case metalUnavailable
  case metalFailure(String)
  case verificationFailed(String)
  @_semantics("derived_enum_equals") @_implements(Equatable, ==(_:_:)) static func __derived_enum_equals(_ a: SuperNeoError, _ b: SuperNeoError) -> Bool
}

